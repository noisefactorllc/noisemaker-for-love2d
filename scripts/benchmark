#!/usr/bin/env python3
import hashlib,json,os,pathlib,subprocess,sys
root=pathlib.Path(__file__).resolve().parent.parent
output=pathlib.Path(sys.argv[1] if len(sys.argv)>1 else root/'parity/out/benchmark.json').resolve()
output.parent.mkdir(parents=True,exist_ok=True)
def hashes():
 return {str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for d in ('noisemaker','tests/benchmark') for p in sorted((root/d).rglob('*')) if p.is_file()}
before=hashes()
subprocess.run([os.environ.get('LOVE_BIN','love'),'tests/benchmark'],cwd=root,env={**os.environ,'NM_BENCHMARK_OUTPUT':str(output)},check=True)
report=json.loads(output.read_text());report['sourceHashes']=before;report['sourceStable']=before==hashes()
output.write_text(json.dumps(report,indent=2)+'\n')
if not report['sourceStable']:raise SystemExit('Sources changed during benchmark; diagnostic only')
print('BENCHMARK '+str(output))
