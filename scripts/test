#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
node --test tests/*.test.mjs
node tools/import-catalog.mjs --check
node tools/import-palettes.mjs --check
node tools/import-shaders.mjs --check
node tools/import-corpus.mjs --check
# The capture tools launch a Playwright browser. The CI workflow installs it
# before this entrypoint; a bare check environment may not have any.
browser_cache="${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}"
if [ -z "$(ls "$browser_cache" 2>/dev/null)" ]; then
  npx playwright install firefox
fi
if [ -n "${LOVE_BIN:-}" ]; then
  LOVE="$LOVE_BIN"
elif command -v love >/dev/null 2>&1; then
  LOVE=$(command -v love)
else
  echo 'scripts/test: LÖVE is required for native CPU checks; set LOVE_BIN.' >&2
  exit 1
fi
# Focused lane (NM_CHANGED_FILES): when the supervisor lists the candidate's changed
# paths, run only the checks that exercise authority-derived data and its catalog
# artifacts. Any changed path outside that set falls through to the full suite, which
# exact-source CI still runs when the variable is unset.
focused=0
if [ -n "${NM_CHANGED_FILES:-}" ]; then
  focused=1
  for changed in $NM_CHANGED_FILES; do
    case "$changed" in
      parity/reference.json|parity/near-policy.json|parity/corpus.json|\
      noisemaker/catalog/*|noisemaker/shaders/source/*) ;;
      *) focused=0 ;;
    esac
  done
fi
if [ "$focused" -eq 1 ]; then
  node --test tests/*.test.mjs
  node tools/import-catalog.mjs --check
  node tools/import-palettes.mjs --check
  node tools/import-shaders.mjs --check
  node tools/import-corpus.mjs --check
  exit 0
fi
"$LOVE" tests/unit
"$LOVE" tests/compiler
"$LOVE" tests/shaders
for tool in check-frontend check-portable check-automation check-inputs check-hooks; do
  LOVE_BIN="$LOVE" node "tools/$tool.mjs"
done
LOVE_BIN="$LOVE" node tools/check-graph.mjs
LOVE_BIN="$LOVE" node tools/check-graph.mjs --upstream
LOVE_BIN="$LOVE" node tools/check-graph.mjs --corpus
LOVE_BIN="$LOVE" node tools/check-graph.mjs --coverage
LOVE_BIN="$LOVE" node tools/check-graph.mjs --variants
LOVE_BIN="$LOVE" node tools/check-graph.mjs --boundary
LOVE_BIN="$LOVE" node tools/check-capture.mjs
LOVE_BIN="$LOVE" node tools/check-array-index.mjs
LOVE_BIN="$LOVE" node tools/check-hooks-raster.mjs
