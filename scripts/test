#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
node --test tests/*.test.mjs
node tools/import-catalog.mjs --check
node tools/import-palettes.mjs --check
node tools/import-shaders.mjs --check
node tools/import-corpus.mjs --check
if [ -n "${LOVE_BIN:-}" ]; then
  LOVE="$LOVE_BIN"
elif command -v love >/dev/null 2>&1; then
  LOVE=$(command -v love)
else
  echo 'scripts/test: LÖVE is required for native CPU checks; set LOVE_BIN.' >&2
  exit 1
fi
"$LOVE" tests/unit
"$LOVE" tests/compiler
"$LOVE" tests/shaders
for tool in check-frontend check-portable check-automation check-inputs check-hooks; do
  LOVE_BIN="$LOVE" node "tools/$tool.mjs"
done
LOVE_BIN="$LOVE" node tools/check-graph.mjs
LOVE_BIN="$LOVE" node tools/check-graph.mjs --upstream
LOVE_BIN="$LOVE" node tools/check-graph.mjs --corpus
LOVE_BIN="$LOVE" node tools/check-graph.mjs --coverage
LOVE_BIN="$LOVE" node tools/check-graph.mjs --variants
LOVE_BIN="$LOVE" node tools/check-capture.mjs
LOVE_BIN="$LOVE" node tools/check-hooks-raster.mjs
